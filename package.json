{
  "name": "datocms-plugin-conditional-dates",
  "description": "Allow editors to enter historical/partial dates where year, month, and/or day may be unknown",
  "homepage": "https://github.com/spleenteo/conditional-dates-datocms-plugin",
  "private": false,
  "version": "0.1.1",
  "author": "Spleenteo <spleenteo@gmail.com>",
  "type": "module",
  "keywords": [
    "datocms-plugin"
  ],
  "datoCmsPlugin": {
    "title": "condates",
    "coverImage": "docs/cover.png",
    "previewImage": "docs/demo.mp4",
    "entryPoint": "dist/index.html",
    "permissions": []
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "datocms-plugin-sdk": "^2.5.0",
    "datocms-react-ui": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "globals": "^15.9.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
}
